# Copy to .env for local dev. Add the same keys in Vercel → Settings → Environment Variables.

# Required
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
SESSION_SECRET_KEY=generate-a-long-random-string

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_YEARLY=price_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_LIFETIME=price_...
STRIPE_PRICE_ID_PERSONAL=price_...
STRIPE_PRICE_ID_STUDIO=price_...
STRIPE_PRICE_ID_PERSONAL_EUR=price_...
STRIPE_PRICE_ID_STUDIO_EUR=price_...
STRIPE_PRICE_ID_PERSONAL_GBP=price_...
STRIPE_PRICE_ID_STUDIO_GBP=price_...
STRIPE_PRICE_ID_PERSONAL_CAD=price_...
STRIPE_PRICE_ID_STUDIO_CAD=price_...
STRIPE_PRICE_ID_PERSONAL_AUD=price_...
STRIPE_PRICE_ID_STUDIO_AUD=price_...
STRIPE_PRICE_ID_SOUND_PACK=price_...
STRIPE_PRICE_ID_PACK_M1_MATRIX=price_...
STRIPE_PRICE_ID_PACK_DX7=price_...
STRIPE_PRICE_ID_PACK_JUNO=price_...

# Email (Resend)
RESEND_API_KEY=re_...
SMTP_FROM=Knob Monster <vault@knob.monster>

# Cron (Vercel cron + GitHub Actions → /api/cron/*)
CRON_SECRET=generate-another-long-random-string

# PostHog
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://e.knob.monster

# Discord alerts (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# OpenRouter (FAQ / AI features, optional)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# Optional
SITE_BASE=https://knob.monster
